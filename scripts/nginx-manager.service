[Unit]
Description=Software Release Manager
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=release-manager
Group=release-manager
WorkingDirectory=/opt/release-manager
ExecStart=/usr/bin/dotnet /opt/release-manager/ReleaseManager.Api.dll --urls http://0.0.0.0:5088
Environment=DOTNET_ENVIRONMENT=Production
Environment=DataRoot=/var/lib/release-manager
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
SyslogIdentifier=release-manager
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/release-manager

[Install]
WantedBy=multi-user.target
